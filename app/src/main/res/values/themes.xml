<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Compose app - uses Material3.
         Parent is an AppCompat theme (not a plain framework theme) because AppCompatActivity
         requires it: below API 33, AppCompatDelegate.setApplicationLocales() only takes effect
         for Activities that register an AppCompatDelegate (ADR 014, decision #2). NoActionBar
         keeps this a pure XML-window theme - all real UI is Compose. -->
    <style name="Theme.Notificapp" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Window attributes for edge-to-edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
