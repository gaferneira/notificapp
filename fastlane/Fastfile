default_platform(:android)

platform :android do
  desc "Assemble a signed release APK (assumes UPLOAD_* signing env vars are set)"
  lane :build_apk do
    gradle(task: "assembleRelease")
  end

  desc "Assemble a signed release AAB (assumes UPLOAD_* signing env vars are set)"
  lane :build_aab do
    gradle(task: "bundleRelease")
  end

  desc "Build the AAB and push it to the Play internal testing track"
  lane :deploy_play_internal do
    # NOTE: the app must already exist in the Play Console — the very first upload for a new
    # applicationId has to be done manually through the console; `upload_to_play_store` (supply)
    # can only update an app that's already been created there.
    build_aab

    # json_key_file comes from the Appfile (PLAY_SERVICE_ACCOUNT_JSON env var, a file path).
    upload_to_play_store(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true,
      # Metadata/screenshot upload from fastlane/metadata/ can be enabled later by dropping
      # skip_upload_metadata / skip_upload_images / skip_upload_screenshots.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
